//
//  Secrets.swift.example
//  YTRun
//
//  Copy this file to Secrets.swift (which is gitignored) and fill in your
//  own values. CloudSyncService uses Secrets.ociParBase as the base URL for
//  an OCI Object Storage Pre-Authenticated Request (PAR) — see
//  requirements.md's "Cloud Sync (manual)" section for the convention.
//
//  If you don't use cloud sync, you can leave this as a placeholder —
//  syncs will just fail to reach the placeholder host.
//

enum Secrets {
    static let ociParBase = "https://objectstorage.<region>.oraclecloud.com/p/<your-par-token>/n/<namespace>/b/<bucket>/o/"
}
